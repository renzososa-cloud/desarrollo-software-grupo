<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">

        <!-- PROVEEDOR JPA -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- CLASES -->
        <class>ar.edu.utn.modelo.Articulo</class>
        <class>ar.edu.utn.modelo.Cliente</class>
        <class>ar.edu.utn.modelo.CondicionIva</class>
        <class>ar.edu.utn.modelo.Contacto</class>
        <class>ar.edu.utn.modelo.Domicilio</class>
        <class>ar.edu.utn.modelo.FacturaVenta</class>
        <class>ar.edu.utn.modelo.FacturaVentaDetalle</class>
        <class>ar.edu.utn.modelo.ListaPrecio</class>
        <class>ar.edu.utn.modelo.ListaPrecioArticulo</class>
        <class>ar.edu.utn.modelo.Marca</class>
        <class>ar.edu.utn.modelo.PuntoVenta</class>
        <class>ar.edu.utn.modelo.Rubro</class>
        <class>ar.edu.utn.modelo.TipoMoneda</class>
        <class>ar.edu.utn.modelo.Usuario</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/facturacion"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>

    </persistence-unit>

</persistence>